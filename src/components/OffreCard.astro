---
const { offre } = Astro.props;
import PbImage from "./PbImage.astro";
const isFavori = Boolean(offre.favori ?? offre.favoris);
const nextFavoriValue = isFavori ? "false" : "true";
---

<article
    class={`offre-card group overflow-hidden rounded-3xl bg-white shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl ${isFavori ? "ring-2 ring-green-500" : ""}`}
    data-favori={isFavori}
>
    <!-- Image avec bouton favori -->
    <div class="relative mx-4 mt-4 overflow-hidden rounded-2xl aspect-[4/3] bg-slate-100">
        <PbImage
            record={offre}
            recordImage={offre.image[0]}
            width={640}
            height={480}
            className="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <!-- Bouton favori en overlay -->
        <button
            type="button"
            class="favoriteButton absolute top-3 right-3 p-2 rounded-full bg-white/90 backdrop-blur-sm shadow-md transition-all hover:scale-110 hover:bg-white"
            data-offre={JSON.stringify(offre)}
        >
            <img
                src={isFavori ? "/favorite_filled.png" : "/favorite.png"}
                alt="favori"
                id="favorite-icon"
                class="w-5 h-5"
                loading="lazy"
                decoding="async"
            />
        </button>
    </div>

    <!-- Contenu -->
    <div class="p-5 pt-4">
        <!-- Titre et prix -->
        <div class="mb-2">
            <h3 class="text-xl font-bold text-slate-900">
                {offre.nomMaison ?? offre.Nom}
            </h3>
            <p class="text-base font-semibold text-green-700">
                {offre.prix ?? offre.Prix}€
            </p>
        </div>

        <!-- Description -->
        <p class="text-sm text-slate-500 leading-relaxed mb-4 line-clamp-2">
            {offre.adresse ?? "Belle maison située dans un quartier prisé, idéale pour une famille."}
        </p>

        <!-- Stats en pills -->
        <div class="flex gap-3 mb-5">
            <div class="flex-1 bg-slate-100 rounded-2xl py-3 px-4 text-center">
                <p class="text-xs text-slate-500 mb-0.5">Surface</p>
                <p class="text-lg font-bold text-slate-900">{offre.superficie ?? offre.surface ?? "-"}</p>
            </div>
            <div class="flex-1 bg-slate-100 rounded-2xl py-3 px-4 text-center">
                <p class="text-xs text-slate-500 mb-0.5">Chambres</p>
                <p class="text-lg font-bold text-slate-900">{offre.nb_chambre ?? offre.nbChambres ?? "-"}</p>
            </div>
        </div>

        <!-- Bouton principal -->
        <a
            href={`/offres/${offre.id}`}
            class="block w-full py-4 bg-slate-900 text-white text-center font-semibold rounded-2xl transition-all hover:bg-slate-800 active:scale-[0.98]"
        >
            Voir le détail
        </a>
    </div>
</article>

<script>
    //@ts-nocheck
    import { setFavori } from "../../backend.js";
    const favoriteButtons = document.querySelectorAll(".favoriteButton");

    favoriteButtons.forEach((button) => {
        button.addEventListener("click", async (event) => {
            event.preventDefault();
            event.stopPropagation();

            const offreData = JSON.parse(button.dataset.offre || "{}");
            const newFavori = !Boolean(offreData.favori ?? offreData.favoris);

            await setFavori(offreData);

            const favIcon = button.querySelector("#favorite-icon");
            if (favIcon) {
                favIcon.src = newFavori
                    ? "/favorite_filled.png"
                    : "/favorite.png";
            }

            offreData.favori = newFavori;
            offreData.favoris = newFavori;
            button.dataset.offre = JSON.stringify(offreData);

            const card = button.closest(".offre-card");
            if (card) {
                card.dataset.favori = String(newFavori);
                if (newFavori) {
                    card.classList.add("ring-2", "ring-green-500");
                } else {
                    card.classList.remove("ring-2", "ring-green-500");
                }
            }
        });
    });
</script>
