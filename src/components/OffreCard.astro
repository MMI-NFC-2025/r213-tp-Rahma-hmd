---
const { offre } = Astro.props;
import PbImage from "./PbImage.astro";
const isFavori = Boolean(offre.favori ?? offre.favoris);
---

<article
    class={`offre-card group overflow-hidden rounded-3xl bg-white shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl ${isFavori ? "ring-2 ring-green-500" : ""}`}
    data-favori={isFavori}
>
    <!-- Image -->
    <div
        class="relative mx-4 mt-4 overflow-hidden rounded-2xl aspect-[4/3] bg-slate-100"
    >
        <PbImage
            record={offre}
            recordImage={offre.image[0]}
            width={640}
            height={480}
            className="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
    </div>

    <!-- Contenu -->
    <div class="p-5 pt-4">
        <!-- Titre et prix -->
        <div class="mb-2">
            <h3 class="text-xl font-bold text-slate-900">
                {offre.nomMaison ?? offre.Nom}
            </h3>
            <p class="text-base font-semibold text-green-700">
                {offre.prix ?? offre.Prix}€
            </p>
        </div>

        <!-- Description -->
        <p class="text-sm text-slate-500 leading-relaxed mb-4 line-clamp-2">
            {
                offre.adresse ??
                    "Belle maison située dans un quartier prisé, idéale pour une famille."
            }
        </p>

        <!-- Stats en pills -->
        <div class="flex gap-3 mb-5">
            <div class="flex-1 bg-slate-100 rounded-2xl py-3 px-4 text-center">
                <p class="text-xs text-slate-500 mb-0.5">Surface</p>
                <p class="text-lg font-bold text-slate-900">
                    {offre.superficie ?? offre.surface ?? "-"}
                </p>
            </div>
            <div class="flex-1 bg-slate-100 rounded-2xl py-3 px-4 text-center">
                <p class="text-xs text-slate-500 mb-0.5">Chambres</p>
                <p class="text-lg font-bold text-slate-900">
                    {offre.nb_chambre ?? offre.nbChambres ?? "-"}
                </p>
            </div>
        </div>

        <!-- Boutons -->
        <div class="flex flex-col gap-3">
            <a
                href={`/offres/${offre.id}`}
                class="block w-full py-4 bg-slate-900 text-white text-center font-semibold rounded-2xl transition-all hover:bg-slate-800 active:scale-[0.98]"
            >
                Voir le détail
            </a>
            <button
                type="button"
                class={`favoriteButton w-full py-3 flex items-center justify-center gap-2 font-semibold rounded-2xl transition-all active:scale-[0.98] ${isFavori ? "bg-green-600 text-white hover:bg-green-700" : "bg-slate-100 text-slate-700 hover:bg-slate-200"}`}
                data-offre={JSON.stringify(offre)}
            >
                <svg
                    class="favorite-icon w-5 h-5"
                    fill={isFavori ? "currentColor" : "none"}
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    ></path>
                </svg>
                <span class="favorite-text"
                    >{
                        isFavori ? "Retirer des favoris" : "Ajouter aux favoris"
                    }</span
                >
            </button>
        </div>
    </div>
</article>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        // Éviter d'attacher plusieurs fois les événements
        if (window.favoriteButtonsInitialized) return;
        window.favoriteButtonsInitialized = true;

        document.body.addEventListener("click", async (event) => {
            const btn = event.target.closest(".favoriteButton");
            if (!btn) return;

            event.preventDefault();
            event.stopPropagation();

            const offreData = JSON.parse(btn.dataset.offre || "{}");
            const newFavori = !(offreData.favori || offreData.favoris);

            // Mise à jour dans PocketBase
            const payload = {};
            if ("favori" in offreData) payload.favori = newFavori;
            if ("favoris" in offreData) payload.favoris = newFavori;
            if (Object.keys(payload).length === 0) payload.favoris = newFavori;

            try {
                const pb = new PocketBase("http://127.0.0.1:8090");
                await pb.collection("Maison").update(offreData.id, payload);

                // Mise à jour du style du bouton
                if (newFavori) {
                    btn.classList.remove(
                        "bg-slate-100",
                        "text-slate-700",
                        "hover:bg-slate-200",
                    );
                    btn.classList.add(
                        "bg-green-600",
                        "text-white",
                        "hover:bg-green-700",
                    );
                } else {
                    btn.classList.remove(
                        "bg-green-600",
                        "text-white",
                        "hover:bg-green-700",
                    );
                    btn.classList.add(
                        "bg-slate-100",
                        "text-slate-700",
                        "hover:bg-slate-200",
                    );
                }

                // Mise à jour de l'icône SVG
                const favIcon = btn.querySelector(".favorite-icon");
                if (favIcon) {
                    favIcon.setAttribute(
                        "fill",
                        newFavori ? "currentColor" : "none",
                    );
                }

                // Mise à jour du texte
                const favText = btn.querySelector(".favorite-text");
                if (favText) {
                    favText.textContent = newFavori
                        ? "Retirer des favoris"
                        : "Ajouter aux favoris";
                }

                // Mise à jour des données
                offreData.favori = newFavori;
                offreData.favoris = newFavori;
                btn.dataset.offre = JSON.stringify(offreData);

                // Mise à jour du style de la card
                const card = btn.closest(".offre-card");
                if (card) {
                    card.setAttribute("data-favori", String(newFavori));
                    if (newFavori) {
                        card.classList.add("ring-2", "ring-green-500");
                    } else {
                        card.classList.remove("ring-2", "ring-green-500");
                    }
                }
            } catch (error) {
                console.error(
                    "Erreur lors de la mise à jour du favori:",
                    error,
                );
                alert("Erreur: " + error.message);
            }
        });
    });
</script>
