---
const { offre } = Astro.props;
import PbImage from "./PbImage.astro";
const isFavori = Boolean(offre.favori ?? offre.favoris);
const nextFavoriValue = isFavori ? "false" : "true";
---

<article
    class={`offre-card group overflow-hidden rounded-2xl border bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl ${isFavori ? "border-green-500" : "border-slate-200"}`}
    data-favori={isFavori}
>
    <div class="relative aspect-video overflow-hidden bg-slate-100">
        <PbImage
            record={offre}
            recordImage={offre.image[0]}
            width={640}
            height={420}
            className="h-full w-full object-cover"
        />
        <form action="/offres" method="POST" class="absolute left-4 top-4 z-10">
            <input type="hidden" name="toggleFavoriId" value={offre.id} />
            <input
                type="hidden"
                name="toggleFavoriValue"
                value={nextFavoriValue}
            />
            <button
                type="submit"
                class={`inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold cursor-pointer ${isFavori ? "bg-green-600 text-white" : "bg-white/90 text-slate-700"}`}
            >
                {isFavori ? "★ Favoris" : "☆ Favoris"}
            </button>
        </form>
    </div>

    <div class="flex flex-col gap-3 p-4 sm:p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h3 class="text-lg font-semibold text-slate-900 sm:text-xl">
                    {offre.nomMaison ?? offre.Nom}
                </h3>
                <p class="mt-1 truncate text-sm text-slate-500">
                    {offre.adresse}
                </p>
            </div>
            <div class="text-right">
                <p
                    class="text-xs font-semibold uppercase tracking-wide text-slate-500"
                >
                    Prix
                </p>
                <p class="text-lg font-bold text-green-700 sm:text-xl">
                    {offre.prix ?? offre.Prix}€
                </p>
                <p class="text-xs text-slate-400">prix total</p>
            </div>
        </div>

        <div class="grid grid-cols-3 divide-x divide-slate-200 text-center">
            <div class="py-1.5">
                <p class="text-base font-semibold text-slate-900">
                    {offre.superficie ?? offre.surface}
                </p>
                <p class="text-xs text-slate-500">m²</p>
            </div>
            <div class="py-1.5">
                <p class="text-base font-semibold text-slate-900">
                    {offre.nb_chambre ?? offre.nbChambres}
                </p>
                <p class="text-xs text-slate-500">chambres</p>
            </div>
            <div class="py-1.5">
                <p class="text-base font-semibold text-slate-900">
                    {offre.nb_sdb ?? offre.nbSdb}
                </p>
                <p class="text-xs text-slate-500">sdb</p>
            </div>
        </div>

        <div class="relative z-10 flex flex-col gap-2">
            <a
                href={`/offres/${offre.id}`}
                class="inline-flex w-full items-center justify-center rounded-xl border border-slate-300 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2"
            >
                Voir plus →
            </a>
            <form action="/offres" method="POST">
                <input type="hidden" name="toggleFavoriId" value={offre.id} />
                <input
                    type="hidden"
                    name="toggleFavoriValue"
                    value={nextFavoriValue}
                />
                <button
                    type="submit"
                    class="inline-flex w-full items-center justify-center rounded-xl border border-green-600/20 bg-green-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-green-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2 cursor-pointer"
                >
                    {isFavori ? "★ Favoris" : "☆ Favoris"}
                </button>
            </form>
        </div>
    </div>
</article>
