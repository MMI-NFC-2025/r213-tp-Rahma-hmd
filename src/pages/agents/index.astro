---
import Layout from "../../layouts/Layout.astro";
import { getAgents, getImageUrl } from "../../js/backend.mjs";

const agents = await getAgents();

const getAgentName = (agent: any) => {
    const byField = agent.nomComplet ?? agent.nom_complet ?? agent.nom;
    if (byField) return byField;

    const fullName = `${agent.prenom ?? ""} ${agent.nom ?? ""}`.trim();
    if (fullName) return fullName;

    return "Agent";
};

const getPhone = (agent: any) => {
    return agent.telephone ?? agent.tel ?? agent.phone ?? "Non renseigné";
};

const getEmail = (agent: any) => {
    return agent.email ?? "Non renseigné";
};

const getRole = (agent: any) => {
    return agent.role ?? agent.poste ?? "Conseiller immobilier";
};

const getImageField = (agent: any) => {
    if (Array.isArray(agent.image) && agent.image.length > 0)
        return agent.image[0];
    if (typeof agent.image === "string" && agent.image.length > 0)
        return agent.image;
    if (Array.isArray(agent.photo) && agent.photo.length > 0)
        return agent.photo[0];
    if (typeof agent.photo === "string" && agent.photo.length > 0)
        return agent.photo;
    if (Array.isArray(agent.avatar) && agent.avatar.length > 0)
        return agent.avatar[0];
    if (typeof agent.avatar === "string" && agent.avatar.length > 0)
        return agent.avatar;
    return null;
};

const agentsWithImage = await Promise.all(
    agents.map(async (agent) => {
        const imageField = getImageField(agent);
        const imageUrl = imageField
            ? await getImageUrl(agent, imageField)
            : null;
        return {
            ...agent,
            imageUrl,
        };
    }),
);
---

<Layout titre="Agents">
    <section class="bg-slate-50 py-10 sm:py-16 px-4">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-3xl sm:text-4xl font-bold mb-2 text-slate-900">
                Nos agents
            </h1>
            <p class="text-slate-500 mb-8 sm:mb-10 text-sm sm:text-base">
                Retrouvez les conseillers de l'agence et leurs coordonnées.
            </p>

            {
                agentsWithImage.length === 0 ? (
                    <div class="rounded-3xl bg-white p-8 text-slate-600 shadow-lg text-center">
                        Aucun agent disponible pour le moment.
                    </div>
                ) : (
                    <div class="grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                        {agentsWithImage.map((agent) => (
                            <article class="group rounded-3xl bg-white shadow-lg overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
                                <!-- Image -->
                                <div class="relative mx-4 mt-4 overflow-hidden rounded-2xl aspect-square bg-slate-100">
                                    {agent.imageUrl ? (
                                        <img
                                            src={agent.imageUrl}
                                            alt={getAgentName(agent)}
                                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    ) : (
                                        <div class="flex h-full w-full items-center justify-center text-slate-400">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                            </svg>
                                        </div>
                                    )}
                                </div>

                                <!-- Contenu -->
                                <div class="p-5 pt-4">
                                    <h2 class="text-xl font-bold text-slate-900">
                                        {getAgentName(agent)}
                                    </h2>
                                    <p class="text-base font-semibold text-green-700 mb-3">
                                        {getRole(agent)}
                                    </p>

                                    <!-- Contact infos -->
                                    <div class="flex flex-col gap-2 mb-5">
                                        <div class="bg-slate-100 rounded-2xl py-3 px-4">
                                            <p class="text-xs text-slate-500 mb-0.5">Email</p>
                                            <p class="text-sm font-semibold text-slate-900 break-all">
                                                {getEmail(agent)}
                                            </p>
                                        </div>
                                        <div class="bg-slate-100 rounded-2xl py-3 px-4">
                                            <p class="text-xs text-slate-500 mb-0.5">Téléphone</p>
                                            <p class="text-sm font-semibold text-slate-900">
                                                {getPhone(agent)}
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Bouton principal -->
                                    <a
                                        href={`/agents/${agent.id}`}
                                        class="block w-full py-4 bg-slate-900 text-white text-center font-semibold rounded-2xl transition-all hover:bg-slate-800 active:scale-[0.98]"
                                    >
                                        Voir ses offres
                                    </a>
                                </div>
                            </article>
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Layout>
