---
import Layout from "../../layouts/Layout.astro";
import OffreCard from "../../components/OffreCard.astro";
import { getOffresByAgentId, oneAgent } from "../../js/backend.mjs";

const { id } = Astro.params;
let agent = null;
if (id) {
    try {
        agent = await oneAgent(id);
    } catch (error) {
        agent = null;
    }
}
const offres = id ? await getOffresByAgentId(id) : [];

const getAgentName = (agentData: any) => {
    if (!agentData) return "Agent";

    const byField =
        agentData.nomComplet ?? agentData.nom_complet ?? agentData.nom;
    if (byField) return byField;

    const fullName = `${agentData.prenom ?? ""} ${agentData.nom ?? ""}`.trim();
    if (fullName) return fullName;

    return "Agent";
};

const agentName = getAgentName(agent);
---

<Layout titre={`Offres de ${agentName}`}>
    <section class="bg-gray-100 py-8 sm:py-12 px-4">
        <div class="max-w-6xl mx-auto">
            <a
                href="/agents"
                class="inline-flex items-center gap-2 mb-4 sm:mb-6 px-3 py-2 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 transition-colors text-sm sm:text-base"
            >
                ← Retour aux agents
            </a>

            {
                !agent ? (
                    <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-6 text-slate-700">
                        Agent introuvable.
                    </div>
                ) : (
                    <>
                        <h1 class="text-2xl sm:text-3xl font-bold mb-2 text-gray-900">
                            Offres de {agentName}
                        </h1>
                        <p class="text-gray-600 mb-6 sm:mb-8 text-sm sm:text-base">
                            Retrouvez toutes les maisons gérées par cet agent.
                        </p>

                        {offres.length === 0 ? (
                            <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-6 text-slate-700">
                                Cet agent n'a pas encore d'offres disponibles.
                            </div>
                        ) : (
                            <div class="grid gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                                {offres.map((offre) => (
                                    <OffreCard offre={offre} />
                                ))}
                            </div>
                        )}
                    </>
                )
            }
        </div>
    </section>
</Layout>
