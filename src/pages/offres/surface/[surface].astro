---
import Layout from "../../../layouts/Layout.astro";
import OffreCard from "../../../components/OffreCard.astro";
import { bySurface } from "../../../../backend";

const minSurface = 80;
const offres = await bySurface(minSurface);
---

<Layout titre="Offres par surface">
    <section class="bg-gray-100 py-12 px-4">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-3xl font-bold mb-4 text-gray-800">
                Maisons avec une surface superieure a {minSurface} m2
            </h1>
            {offres.length === 0 ? (
                <p class="text-gray-600">
                    Aucune offre ne correspond a ce critere.
                </p>
            ) : (
                <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {offres.map((offre) => (
                        <OffreCard offre={offre} />
                    ))}
                </div>
            )}
        </div>
    </section>
</Layout>

