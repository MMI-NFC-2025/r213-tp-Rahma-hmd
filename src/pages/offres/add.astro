<h1 class="text-lg">Ajouter une offre</h1>
<form action="/offres/add" method="POST" enctype="multipart/form-data">
    <input
        type="text"
        name="nomMaison"
        placeholder="Nom de la maison"
        required
        class="w-full mt-2 p-2 border border-gray-300 rounded-md"
    />
    <input type="number" name="prix" placeholder="Prix" />
    <input type="number" name="nb_sdb" placeholder="Nombre de salles de bain" />
    <input type="number" name="nb_chambre" placeholder="Nombre de chambres" />
    <input type="number" name="superficie" placeholder="Superficie" />
    <input type="file" name="image" />
    <button type="submit">Ajouter</button>
</form>
