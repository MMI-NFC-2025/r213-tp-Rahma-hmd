---
import Layout from "../../../layouts/Layout.astro";
import OffreCard from "../../../components/OffreCard.astro";
import { getOffreByPrix } from "../../../../backend";

const { prix } = Astro.params;
const prixValue = Number(prix);
const hasValidPrix = Number.isFinite(prixValue);
const offres = hasValidPrix ? await getOffreByPrix(prixValue) : [];
---

<Layout titre="Offres par prix">
    <section class="bg-gray-100 py-8 sm:py-12 px-4">
        <div class="max-w-6xl mx-auto">
            <a
                href="/offres"
                class="inline-flex items-center gap-2 mb-4 sm:mb-6 px-3 py-2 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 transition-colors text-sm sm:text-base"
            >
                ← Retour aux offres
            </a>
            <h1 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-800">
                Maisons avec un prix supérieur à 200 000 €
            </h1>
            {
                !hasValidPrix ? (
                    <p class="text-gray-600">
                        Le parametre de prix est invalide.
                    </p>
                ) : offres.length === 0 ? (
                    <p class="text-gray-600">
                        Aucune offre ne correspond a ce critere.
                    </p>
                ) : (
                    <div class="mt-4 sm:mt-6 grid gap-4 sm:gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                        {offres.map((offre) => (
                            <OffreCard offre={offre} />
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Layout>
