---
import Layout from "../../layouts/Layout.astro";
import OffreCard from "../../components/OffreCard.astro";
import * as backendApi from "../../js/backend.mjs";
import { addOffre, updateFavori } from "../../../backend";

let message = "";
let Offres = [];
let isPrixFiltered = false;

const normalizePrix = (value: unknown) => {
    if (typeof value === "number") return value;
    if (typeof value !== "string") return NaN;
    const cleaned = value.replace(/[^\d,.-]/g, "").replace(",", ".");
    return Number(cleaned);
};

if (Astro.request.method === "POST") {
    const data = await Astro.request.formData();

    if (data.has("nomMaison")) {
        const response = await addOffre(data);
        message = response.message;
        Offres = await backendApi.getOffres();
    } else if (data.has("toggleFavoriId")) {
        const offreId = String(data.get("toggleFavoriId") ?? "");
        const favoriValue =
            String(data.get("toggleFavoriValue") ?? "false") === "true";
        const response = await updateFavori(offreId, favoriValue);
        message = response.message;
        Offres = await backendApi.getOffres();
    } else {
        const minPrix = Number(data.get("minPrix"));
        const maxPrix = Number(data.get("maxPrix"));

        if (minPrix > 0 && maxPrix > 0 && maxPrix > minPrix) {
            isPrixFiltered = true;
            const toutesLesOffres = await backendApi.getOffres();
            Offres = toutesLesOffres.filter((offre: any) => {
                const prix = normalizePrix(offre.prix ?? offre.Prix);
                return (
                    Number.isFinite(prix) && prix >= minPrix && prix <= maxPrix
                );
            });
            if (Offres.length === 0) {
                message = `Pas d'offres entre ${minPrix}€ et ${maxPrix}€`;
            } else {
                message = `Liste des offres entre ${minPrix}€ et ${maxPrix}€`;
            }
        } else {
            message = "Veuillez entrer des valeurs valides pour le prix.";
            Offres = await backendApi.getOffres();
        }
    }
} else {
    Offres = await backendApi.getOffres();
}
---

<Layout titre="Offres">
    <section class="bg-gray-100 py-12 px-4">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-3xl font-bold mb-8 text-gray-800">Nos Offres</h1>
            <div class="bg-white rounded-lg shadow p-6">
                <form
                    action="/offres"
                    method="POST"
                    class="mb-6 rounded-xl border border-slate-200 bg-slate-50 p-4 flex flex-wrap items-end gap-3"
                >
                    <div class="flex flex-col gap-1">
                        <label
                            for="minPrix"
                            class="text-xs font-semibold text-slate-600"
                            >Prix minimum</label
                        >
                        <input
                            id="minPrix"
                            type="number"
                            name="minPrix"
                            placeholder="Ex : 150000"
                            class="w-44 p-2.5 border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                        />
                    </div>
                    <div class="flex flex-col gap-1">
                        <label
                            for="maxPrix"
                            class="text-xs font-semibold text-slate-600"
                            >Prix maximum</label
                        >
                        <input
                            id="maxPrix"
                            type="number"
                            name="maxPrix"
                            placeholder="Ex : 300000"
                            class="w-44 p-2.5 border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                        />
                    </div>
                    <input
                        type="submit"
                        value="Filtrer par prix"
                        class="px-4 py-2.5 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors cursor-pointer font-semibold"
                    />
                    {
                        isPrixFiltered && (
                            <a
                                href="/offres"
                                class="px-4 py-2.5 bg-white text-slate-700 rounded-lg border border-slate-300 hover:bg-slate-100 transition-colors font-semibold"
                            >
                                Réinitialiser les filtres
                            </a>
                        )
                    }
                </form>
                {
                    message && (
                        <p class="mb-4 rounded-md bg-slate-100 px-3 py-2 text-sm text-slate-700">
                            {message}
                        </p>
                    )
                }
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h2 class="text-2xl font-semibold mb-2">
                            Maisons disponibles
                        </h2>
                        <p class="text-gray-600">
                            Découvrez nos offres de maisons disponibles.
                        </p>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                        <a
                            href="/offres/surface/50"
                            class="px-4 py-2 bg-white text-slate-700 rounded-lg border border-slate-200 hover:bg-slate-50 transition-colors whitespace-nowrap"
                        >
                            Maison avec surface superieur 80 m2
                        </a>
                        <a
                            href="/offres/prix/200000"
                            class="px-4 py-2 bg-white text-slate-700 rounded-lg border border-slate-200 hover:bg-slate-50 transition-colors whitespace-nowrap"
                        >
                            Maisons prix superieur a 200 000 euros
                        </a>
                        <button
                            id="favori-button"
                            class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors whitespace-nowrap"
                        >
                            Afficher les favoris
                        </button>
                    </div>
                </div>
                <details
                    class="mb-6 rounded-xl border border-slate-200 bg-slate-50 p-4"
                >
                    <summary
                        class="cursor-pointer text-lg font-semibold text-slate-800"
                    >
                        Ajouter une offre
                    </summary>
                    <form
                        action="/offres"
                        method="POST"
                        enctype="multipart/form-data"
                        class="mt-4 grid gap-3"
                    >
                        <input
                            type="text"
                            name="nomMaison"
                            placeholder="Nom de la maison"
                            required
                            class="w-full p-2.5 border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                        />
                        <input
                            type="number"
                            name="prix"
                            placeholder="Prix"
                            class="w-full p-2.5 border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                        />
                        <input
                            type="number"
                            name="nb_sdb"
                            placeholder="Nombre de salles de bain"
                            class="w-full p-2.5 border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                        />
                        <input
                            type="number"
                            name="nb_chambre"
                            placeholder="Nombre de chambres"
                            class="w-full p-2.5 border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                        />
                        <input
                            type="number"
                            name="superficie"
                            placeholder="Superficie"
                            class="w-full p-2.5 border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500"
                        />
                        <input
                            type="file"
                            name="image"
                            class="w-full p-2.5 border border-slate-300 rounded-lg bg-white text-slate-700 file:mr-3 file:rounded-md file:border-0 file:bg-slate-200 file:px-3 file:py-1.5 file:text-slate-700 hover:file:bg-slate-300"
                        />
                        <button
                            type="submit"
                            class="px-4 py-2.5 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-semibold"
                        >
                            Ajouter
                        </button>
                    </form>
                </details>
                <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {Offres.map((offre: any) => <OffreCard offre={offre} />)}
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    //@ts-nocheck
    const button = document.getElementById("favori-button");
    let showOnlyFavorites = false;

    button?.addEventListener("click", () => {
        showOnlyFavorites = !showOnlyFavorites;
        const cartes = document.querySelectorAll(".offre-card");
        console.log("Cartes trouvées:", cartes.length);
        console.log("Mode favoris:", showOnlyFavorites);

        cartes.forEach((carte) => {
            const isFavori = carte.dataset.favori === "true";
            console.log(
                "Carte favori:",
                carte.dataset.favori,
                "isFavori:",
                isFavori,
            );

            if (showOnlyFavorites) {
                carte.style.display = isFavori ? "block" : "none";
            } else {
                carte.style.display = "block";
            }
        });

        button.textContent = showOnlyFavorites
            ? "Afficher tout"
            : "Afficher les favoris";
    });
</script>
