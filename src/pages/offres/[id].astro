---
const { id } = Astro.params;
const offre = await getOffre(id);
import Layout from "../../layouts/Layout.astro";
import { getOffre } from "../../../backend";
---

<Layout titre={offre ? (offre.nomMaison ?? offre.Nom) : "Offre introuvable"}>
    {
        offre ? (
            <>
                <h2>{offre.nomMaison ?? offre.Nom}</h2>
                <ul>
                    <li>{offre.adresse}</li>
                    ...
                </ul>
            </>
        ) : (
            <p>Offre introuvable.</p>
        )
    }
</Layout>
