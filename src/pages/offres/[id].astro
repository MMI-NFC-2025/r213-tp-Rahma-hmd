---
const { id } = Astro.params;
const offre = await getOffre(id);
import Layout from "../../layouts/Layout.astro";
import { getOffre } from "../../../backend";
import PbImage from "../../components/PbImage.astro";
---

<Layout titre={offre ? (offre.nomMaison ?? offre.Nom) : "Offre introuvable"}>
    <section class="bg-gray-100 py-6 sm:py-10 px-4">
        <div class="max-w-5xl mx-auto">
            <a
                href="/offres"
                class="inline-flex items-center gap-2 mb-4 sm:mb-6 px-3 py-2 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 transition-colors text-sm sm:text-base"
            >
                ← Retour aux offres
            </a>

            {
                offre ? (
                    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        {offre.image?.length > 0 && (
                            <div class="w-full aspect-video overflow-hidden bg-slate-100">
                                <PbImage
                                    record={offre}
                                    recordImage={offre.image[0]}
                                    width={1280}
                                    height={720}
                                    className="h-full w-full object-cover"
                                />
                            </div>
                        )}

                        <div class="p-6 sm:p-8">
                            <div class="flex flex-wrap items-start justify-between gap-4">
                                <div>
                                    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">
                                        {offre.nomMaison ?? offre.Nom}
                                    </h1>
                                    <p class="mt-2 text-slate-600">
                                        {offre.adresse ??
                                            "Adresse non renseignée"}
                                    </p>
                                </div>
                                <div class="rounded-xl bg-green-50 px-4 py-3 text-right">
                                    <p class="text-xs font-semibold uppercase tracking-wide text-green-700">
                                        Prix
                                    </p>
                                    <p class="text-2xl font-bold text-green-700">
                                        {offre.prix ?? offre.Prix}€
                                    </p>
                                </div>
                            </div>

                            <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-3">
                                <div class="rounded-xl border border-slate-200 p-4">
                                    <p class="text-xs uppercase tracking-wide text-slate-500">
                                        Superficie
                                    </p>
                                    <p class="mt-1 text-lg font-semibold text-slate-900">
                                        {offre.superficie ??
                                            offre.surface ??
                                            "-"}{" "}
                                        m²
                                    </p>
                                </div>
                                <div class="rounded-xl border border-slate-200 p-4">
                                    <p class="text-xs uppercase tracking-wide text-slate-500">
                                        Chambres
                                    </p>
                                    <p class="mt-1 text-lg font-semibold text-slate-900">
                                        {offre.nb_chambre ??
                                            offre.nbChambres ??
                                            "-"}
                                    </p>
                                </div>
                                <div class="rounded-xl border border-slate-200 p-4">
                                    <p class="text-xs uppercase tracking-wide text-slate-500">
                                        Salles de bain
                                    </p>
                                    <p class="mt-1 text-lg font-semibold text-slate-900">
                                        {offre.nb_sdb ?? offre.nbSdb ?? "-"}
                                    </p>
                                </div>
                            </div>

                            <div class="mt-6 rounded-xl bg-slate-50 p-4 sm:p-5">
                                <h2 class="text-lg font-semibold text-slate-900">
                                    Description de l'annonce
                                </h2>
                                <p class="mt-2 text-slate-700 leading-relaxed">
                                    {offre.description ??
                                        offre.descriptif ??
                                        `Belle maison ${offre.nomMaison ?? offre.Nom} située à ${offre.adresse ?? "un emplacement recherché"}, idéale pour une famille grâce à ses espaces confortables et sa bonne luminosité.`}
                                </p>
                            </div>
                        </div>
                    </article>
                ) : (
                    <div class="rounded-xl border border-slate-200 bg-white p-6 text-slate-700">
                        Offre introuvable.
                    </div>
                )
            }
        </div>
    </section>
</Layout>
