---
import Layout from "../layouts/Layout.astro";
---

<Layout titre="Accueil">
	<!-- Hero Section -->
	<section
		class="bg-gradient-to-r from-green-800 to-green-700 text-white py-20 px-4 overflow-hidden"
	>
		<div class="max-w-6xl mx-auto text-center">
			<h1 class="text-5xl font-bold mb-4">Agence Habity</h1>
			<p class="text-xl mb-8 text-green-100">
				Trouvez votre propriété idéale
			</p>
			<a
				href="/offres"
				class="bg-white text-green-800 px-8 py-3 rounded-lg font-bold hover:bg-green-50 transition-colors shadow-lg"
			>
				Voir les offres
			</a>
		</div>
	</section>

	<!-- Content Section -->
	<section class="py-16 px-4 bg-gray-50">
		<div class="max-w-6xl mx-auto">
			<h2 class="text-3xl font-bold mb-6 text-green-900">À propos</h2>
			<p class="text-green-800 mb-4 text-lg">
				Nous vous aider à trouver votre maison de rêve. Vente, achat, ou
				location, nous sommes là pour vous.
			</p>
		</div>
	</section>
</Layout>
